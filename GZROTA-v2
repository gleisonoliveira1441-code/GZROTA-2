studs" obj.distancia.Position=Vector2.new(hrpPos.X,hrpPos.Y+alt/2+10) end end else obj.box.Visible=false obj.linha.Visible=false obj.vida.Visible=false obj.distancia.Visible=false end elseif espObjs[pl] then limparEspObjs(pl) end elseif espObjs[pl] then limparEspObjs(pl) end end
